        <!-- KPIs por nivel (notas) -->
        <mxCell id="kpi3" value="&lt;b&gt;IL3 · calidad de datos&lt;/b&gt; (medido en cada corrida)&lt;br&gt;cobertura 100% · completitud 99,999%&lt;br&gt;duplicidad 0% · campos 100% · frescura 3 días" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#E1F5EC;strokeColor=#1BAF7A;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
