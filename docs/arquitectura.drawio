        </mxCell>
        <mxCell id="kpi4" value="&lt;b&gt;IL4 · operación&lt;/b&gt; (logs)&lt;br&gt;corridas sin error 100% · duración máx. 25 s (meta &amp;lt; 5 min)&lt;br&gt;SLA lunes 08:00 y frecuencia de uso: definidos" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF4D9;strokeColor=#C98500;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
